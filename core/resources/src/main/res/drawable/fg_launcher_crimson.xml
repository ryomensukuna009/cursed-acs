<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smooth 4-Corner Rounded Rectangle Card with Glowing Crimson Border -->
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#160808" />
            <stroke android:width="2dp" android:color="#FF5449" />
        </shape>
    </item>
    <!-- Centered Crimson Domain Brand Asset -->
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="center"
        android:drawable="@drawable/logo_crimson_domain" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="20dp">

    <!-- Header: Icon, Model Name, Provider & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/dialogModelIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/logo_dual_aura"
            android:contentDescription="Model Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogModelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gemini-2.5-flash"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogProviderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Google Gemini API • 🟢 Connected"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp" />

    <!-- Capability Cards Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Context Length Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Context Window"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dialogContextLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1,048,576 tokens (~4.2M chars)"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tools Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Tool Execution"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dialogToolStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Verified • 8 IDE Tools Active"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Modalities Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Modalities"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dialogModalities"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Text, Code, Multimodal Vision"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

        </LinearLayout>

        <!-- Protocol & Endpoint Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="API Protocol"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dialogProtocol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Google Gemini REST API"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

        </LinearLayout>

    </LinearLayout>

    <!-- Token Budget & Context Window Telemetry Section -->
    <LinearLayout
        android:id="@+id/dialogUsageTelemetrySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_code_tag"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Context Window Occupancy"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/dialogContextMeterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 32,000 tk (0.0%)"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/dialogContextProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progress="0"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            style="@style/Widget.Material3.LinearProgressIndicator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available Budget Remaining"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/dialogRemainingBudgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32,000 tk (100% free)"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="#22C55E" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/dialogRemainingBudgetProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:max="100"
            android:progress="100"
            app:indicatorColor="#22C55E"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            style="@style/Widget.Material3.LinearProgressIndicator" />

        <!-- Model Capabilities Badges -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model Capabilities"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/dialogCapabilitiesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipToolCalling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛠️ Tools Active"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_code_tag"
                    android:textSize="11sp"
                    android:textColor="#22C55E"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipVision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁️ Multimodal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_code_tag"
                    android:textSize="11sp"
                    android:textColor="#3B82F6"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipStreaming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Realtime Stream"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_code_tag"
                    android:textSize="11sp"
                    android:textColor="#EAB308"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipReasoning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Extended CoT"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_code_tag"
                    android:textSize="11sp"
                    android:textColor="#EC4899"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipCodeEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 Auto-Patch"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_code_tag"
                    android:textSize="11sp"
                    android:textColor="#A855F7"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipWebSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Web Grounding"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_code_tag"
                    android:textSize="11sp"
                    android:textColor="#06B6D4" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/dialogTokenBreakdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last Request: In: 0 • Out: 0 • Latency: --"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/dialogCumulativeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Session Usage: 0 prompt + 0 completion tokens"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/dialogAccountQuotaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Account Quota: Not reported by provider"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />


    </LinearLayout>

    <!-- Compact Context Action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogBtnCompactContext"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="🧹 Compact Context Now"
        android:textSize="12.5sp"
        app:cornerRadius="12dp" />

    <!-- Action Buttons: 2-Row Spacious Responsive Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnSearchModels"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Search Models"
                android:textSize="12.5sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnSwitchProvider"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Switch Provider"
                android:textSize="12.5sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnConfigureKey"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Configure Provider &amp; API Key"
            android:textSize="13sp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>

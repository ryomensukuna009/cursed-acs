<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <!-- Drag Handle (Rounded Squircle Bar) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IDE Tools &amp; Actions"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Section 1: Project & Build -->
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUILD &amp; VERSION CONTROL"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Build Engine Switch Row (Offline NDK vs Standard Gradle) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBuildModeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_android"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBuildModeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline NDK Builder"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBuildModeSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fast offline native compilation without Gradle daemon"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBuildMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Git Client Row -->
        <LinearLayout
            android:id="@+id/toolGitClient"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_git"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="Git Version Control" />
        </LinearLayout>

        <!-- Build Variants Row -->
        <LinearLayout
            android:id="@+id/toolBuildVariants"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_android"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="Build Variants &amp; Flavors" />
        </LinearLayout>

        <!-- Asset Studio Row -->
        <LinearLayout
            android:id="@+id/toolAssetStudio"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_asset_studio"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="Asset Studio (Icons &amp; Vectors)" />
        </LinearLayout>

        <!-- Sub-Module Maker Row -->
        <LinearLayout
            android:id="@+id/toolSubModules"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add_module"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="Sub-Module Maker" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp" />

    <!-- Section 2: System & Settings -->
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SYSTEM &amp; SETTINGS"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- NDK Management Row -->
        <LinearLayout
            android:id="@+id/toolNdkManagement"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_code"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="NDK Toolchain Management" />
        </LinearLayout>

        <!-- Terminal Row -->
        <LinearLayout
            android:id="@+id/toolTerminal"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_terminal"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="Integrated Shell Terminal" />
        </LinearLayout>

        <!-- Preferences Row -->
        <LinearLayout
            android:id="@+id/toolPreferences"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:text="IDE Preferences &amp; Themes" />
        </LinearLayout>

        <!-- Close Project Row -->
        <LinearLayout
            android:id="@+id/toolCloseProject"
            style="@style/Widget.AndroidIDE.ToolSheetRow">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorError"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorError" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.AndroidIDE.ToolSheetText"
                android:textColor="?attr/colorError"
                android:text="Close Active Project" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

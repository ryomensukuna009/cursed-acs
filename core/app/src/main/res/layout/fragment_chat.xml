<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Compact Top Header: Model Chip, Web Toggle, Conversations & New Chat -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:elevation="2dp">

        <!-- Classic Top Header: Model Chip & Web Toggle (Only in classic Crimson/Cyan themes) -->
        <LinearLayout
            android:id="@+id/classicTopChipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/activeModelChipBtn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="🟢 Gemini • gemini-2.5-flash"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="11.5sp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webSearchToggleBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="38dp"
                android:paddingHorizontal="8dp"
                android:text="🌐 Off"
                android:textSize="11.5sp"
                app:cornerRadius="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

        <!-- Responsive Active Session & Mode Header -->
        <LinearLayout
            android:id="@+id/sessionSubheader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Live Token Telemetry Row (Includes New Chat & Options Menu) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/conversationTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Conversation"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/liveTokenBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_tag"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="0 tk"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="6dp"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/newChatBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="34dp"
                    android:paddingHorizontal="8dp"
                    android:text="＋ New"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.TonalButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatOverflowMenuBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="34dp"
                    android:padding="0dp"
                    android:contentDescription="Chat options"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_more_vert"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="?attr/colorOnSurface"
                    style="@style/Widget.Material3.Button.TonalButton" />

            </LinearLayout>

            <!-- Mode Chips & Live Activity Banner Scroll Row -->
            <HorizontalScrollView
                android:id="@+id/modeChipScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:fadingEdge="horizontal"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/modeControlPanel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeSwitcherChipBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="32dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="0dp"
                            android:text="🤖 Auto"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApprovalMode"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="32dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="0dp"
                            android:text="⚡ Turbo"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReasoningEffort"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginStart="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="32dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="0dp"
                            android:text="🧠 Auto"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="16dp"
                        app:trackThickness="2dp"
                        style="@style/Widget.Material3.CircularProgressIndicator" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/toolStatusBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="11sp"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 2. Chronological Multi-Turn Message List & Empty State -->
    <FrameLayout
        android:id="@+id/messageAreaContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            android:scrollbars="vertical" />

        <!-- Empty State with Quick Prompt Starters -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 CURSED AI Agent"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi-turn conversation memory, project-aware multi-file edits, and automatic error repair."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/starterInspectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="🔍 Inspect project structure &amp; build mode"
                android:textSize="11.5sp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/starterFixErrorsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="🛠️ Diagnose &amp; fix current project errors"
                android:textSize="11.5sp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

        <!-- Floating Jump to Latest Pill -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/jumpToLatestBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="↓ Jump to latest"
            android:textSize="11.5sp"
            android:elevation="6dp"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton" />

    </FrameLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 3. Bottom-Anchored Keyboard-Aware Multi-Line Composer -->
    <LinearLayout
        android:id="@+id/composerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?attr/colorSurface"
        android:elevation="6dp">

        <!-- Floating Hold Request Pill Banner -->
        <LinearLayout
            android:id="@+id/holdRequestBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_count_pill_accent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvHoldBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏸️ Approval On Hold • Tap to review"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumeHeldRequest"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:minWidth="32dp"
                android:text="Review"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/attachedImageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/attachedImagePreview"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveAttachedImage"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_clear"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:cornerRadius="11dp"
                style="@style/Widget.Material3.Button.IconButton.Filled" />
        </FrameLayout>

        <!-- Classic ACS Outlined Composer (Crimson, Cyan, Slate, etc.) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/classicPromptLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ask a question or describe code changes…"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:startIconDrawable="@drawable/ic_add"
            app:startIconContentDescription="Attach photo or screenshot"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_send"
            app:endIconTint="?attr/colorPrimary"
            app:endIconContentDescription="Send message"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.tom.rv2ide.ui.ChatComposerEditText
                android:id="@+id/classicAnyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="1"
                android:maxLines="5"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:includeFontPadding="false"
                android:gravity="center_vertical|start"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Kelivo-Style Sleek Floating Composer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/kelivoComposerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingHorizontal="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/promptLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ask anything or describe code changes…"
                    app:boxBackgroundMode="none"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="true"
                    app:endIconMode="none"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.tom.rv2ide.ui.ChatComposerEditText
                        android:id="@+id/anyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="1"
                        android:maxLines="6"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="4dp"
                        android:includeFontPadding="false"
                        android:gravity="top|start"
                        android:textSize="14.5sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Kelivo Bottom Action Controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <!-- Left Actions Group -->
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none"
                        android:fadingEdge="horizontal"
                        android:fillViewport="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Model Selector Pill (Kelivo Boxes) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnComposerModel"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                android:minWidth="32dp"
                                android:layout_marginEnd="6dp"
                                android:text="📦 Model"
                                android:textSize="11.5sp"
                                app:cornerRadius="8dp"
                                style="@style/Widget.Material3.Button.TonalButton" />

                            <!-- Web Search Button (Kelivo Globe) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnComposerWebSearch"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:padding="0dp"
                                android:minWidth="32dp"
                                android:layout_marginEnd="6dp"
                                android:text="🌐"
                                android:textSize="13sp"
                                app:cornerRadius="8dp"
                                style="@style/Widget.Material3.Button.IconButton.Filled" />

                            <!-- Attach Image / File Button (Kelivo Plus) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnComposerAttach"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:padding="0dp"
                                android:minWidth="32dp"
                                android:layout_marginEnd="6dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp"
                                style="@style/Widget.Material3.Button.IconButton.Filled" />

                            <!-- Reasoning Effort Button (Kelivo Brain) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnComposerReasoning"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                android:minWidth="32dp"
                                android:layout_marginEnd="6dp"
                                android:text="🧠 Auto"
                                android:textSize="11.5sp"
                                app:cornerRadius="8dp"
                                style="@style/Widget.Material3.Button.TonalButton" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Right Action: Circular Send / Stop Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnComposerSend"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="0dp"
                        android:minWidth="36dp"
                        android:layout_marginStart="6dp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_arrow_upward"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="18dp"
                        style="@style/Widget.Material3.Button.IconButton.Filled" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden compatibility views for AIRequestHandler / ViewBinding -->
        <LinearLayout
            android:id="@+id/hiddenCompatibilityButtons"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/executeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- Hidden Legacy Views for ViewBinding Compatibility -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fileModificationList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/citationsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/citationsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/summaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Real Initial IDE Loading & Branding Surface (Always present at startup) -->
    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/splashLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/logo_sukuna_full"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:strokeWidth="2.5dp"
            app:strokeColor="#FF2A55" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="CURSED ACS"
            android:textColor="#FF2A55"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="UNLEASH THE CURSED CODE"
            android:textColor="#A0AAB8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Realtime active startup initialization progress indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splashLoadingProgress"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            app:indicatorColor="#FF2A55"
            app:trackColor="#33FF2A55"
            app:trackCornerRadius="4dp"
            app:trackThickness="3dp" />

    </LinearLayout>

    <!-- 2. Sukuna Domain Expansion HTML5 Canvas 60fps Surface (Layered OVER Loading Experience) -->
    <WebView
        android:id="@+id/splashWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Minimalist tap to skip button -->
    <TextView
        android:id="@+id/splashSkipHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_skip_pill"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:letterSpacing="0.03"
        android:text="Tap to skip ➔"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp"
        android:textStyle="normal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

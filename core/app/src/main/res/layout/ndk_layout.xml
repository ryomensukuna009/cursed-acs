<?xml version="1.0" encoding="utf-8"?>
<com.tom.customizablecardview.CustomizableCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ndkCardHolder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:setCardStroke="0sp"
    app:setCardTitle="Android NDK Toolchains"
    app:isCheckableCard="false"
    app:isClickableCard="true"
    app:setCardSummary="@string/cfg_installed_ndk_version"
    app:setCardIconHeight="30dp"
    app:setCardIconWidth="30dp"
    app:setSummaryTextSize="12dp"
    app:setTitleTextSize="18dp"
    app:noIconBackground="true"
    app:noIcon="true"
    app:setCardElevation="0dp"
    app:setCardIcon="@drawable/ic_cfg">

    <!-- SECTION 1: Offline NDK (Local Import & Installed) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        android:text="Offline NDK (Local Import &amp; Installed)"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tvActiveNdkInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="4dp"
        android:text="Detected native compiler version and readiness."
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/active_ndk_dropdown_layout"
        style="@style/AppTheme.TextInputLayout.Dropdown.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:hint="Active Offline NDK (Build System)">

        <AutoCompleteTextView
            android:id="@+id/active_ndk_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cornerRadius="12dp"
            app:iconSize="20dp"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:icon="@drawable/ic_add"
            android:text="Import Archive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/test_ndk_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:cornerRadius="12dp"
            app:iconSize="20dp"
            app:backgroundTint="?attr/colorSurfaceContainerHigh"
            app:icon="@drawable/ic_code"
            android:text="Smoke Test" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/remove_btn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        app:cornerRadius="12dp"
        app:iconSize="20dp"
        app:backgroundTint="?attr/colorErrorContainer"
        app:iconTint="?attr/colorOnErrorContainer"
        android:textColor="?attr/colorOnErrorContainer"
        app:icon="@drawable/ic_delete"
        android:text="Delete Installed NDK" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- SECTION 2: Online SDK Manager NDK (Repository Download) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:text="SDK Manager NDK (Online Download)"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ndks_dropdown_layout"
        style="@style/AppTheme.TextInputLayout.Dropdown.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:hint="Available Remote NDK Versions">

        <AutoCompleteTextView
            android:id="@+id/ndks_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reinstall_btn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        app:cornerRadius="12dp"
        app:iconSize="20dp"
        app:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:icon="@drawable/download"
        android:text="Download &amp; Install" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- SECTION 3: OpenJDK 17 Java Runtime (Optional) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:text="OpenJDK 17 Compiler (Optional)"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvJdkOfflineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="4dp"
        android:text="Embedded in-process Java compiler is ready. Download external OpenJDK 17 if CLI javac is desired."
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadJdkOffline"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        app:cornerRadius="12dp"
        app:iconSize="20dp"
        app:backgroundTint="?attr/colorSurfaceContainerHigh"
        app:icon="@drawable/download"
        android:text="Download OpenJDK 17 (Optional)" />

</com.tom.customizablecardview.CustomizableCardView>

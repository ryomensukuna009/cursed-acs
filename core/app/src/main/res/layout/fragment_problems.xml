<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top Live Problems Overview Header -->
    <LinearLayout
        android:id="@+id/problemsHeaderOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:background="?attr/colorSurfaceContainerLow">

        <ImageView
            android:id="@+id/problemsStatusIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/status_success"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/problemsOverviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Problems Detected"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/problemsOverviewSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workspace up to date"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Current Build State Badge -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/buildStateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Ready"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/bg_code_tag"
            android:layout_marginEnd="4dp" />

        <!-- Refresh Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshDiagnosticsBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="36dp"
            android:minHeight="36dp"
            app:icon="@drawable/ic_refresh"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:contentDescription="Re-scan diagnostics" />

        <!-- More Options (Group, Sort, Expand/Collapse) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/problemsMoreOptionsBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="36dp"
            android:minHeight="36dp"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:contentDescription="Grouping and sorting options" />

    </LinearLayout>

    <!-- Fast Search Input Row -->
    <LinearLayout
        android:id="@+id/problemsSearchBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_code_tag">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/problemsSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search errors, files, codes…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/problemsClearSearchBtn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Filter Chips Horizontal Scroll Container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:checked="true"
                android:text="All (0)"
                android:textSize="11sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterErrors"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Errors (0)"
                android:textSize="11sp"
                app:chipIcon="@drawable/ic_error"
                app:chipIconTint="@color/status_error" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterWarnings"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Warnings (0)"
                android:textSize="11sp"
                app:chipIcon="@drawable/ic_warning"
                app:chipIconTint="@color/status_warning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterCurrentFile"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Current File"
                android:textSize="11sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterBuild"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Build Issues"
                android:textSize="11sp" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Grouping & Expand/Collapse Info Bar -->
    <LinearLayout
        android:id="@+id/problemsGroupingBar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="?attr/colorSurfaceContainerLow">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/problemsGroupingStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Grouped by File · Sorted by Severity"
            android:textSize="10.5sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/toggleExpandAllBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Collapse All"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <!-- Grouped Problems RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/problemsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <!-- Clean Empty State (0 Problems) -->
    <LinearLayout
        android:id="@+id/problemsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/status_success"
            android:contentDescription="No problems" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/problemsEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/problems_empty_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/problemsEmptySummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/problems_empty_summary"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</LinearLayout>
